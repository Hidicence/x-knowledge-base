# ══════════════════════════════════════════════════════
# x-knowledge-base 環境變數設定範例
# 使用方式：複製此檔案為 .env；只在本機或 secret manager 填入真實值
# ══════════════════════════════════════════════════════

# ── 必填：X / Twitter 認證 ──────────────────────────
# 請用自己的安全 credential 管理方式注入，絕不要把真實值 commit
BIRD_AUTH_TOKEN=replace-with-your-bird-auth-token
BIRD_CT0=replace-with-your-bird-ct0

# ── 選填：推薦腳本的 Twitter 認證 ──────────────────
TWITTER_AUTH_TOKEN=replace-with-your-twitter-auth-token
TWITTER_CT0=replace-with-your-twitter-ct0

# ── 選填：AI 摘要 ───────────────────────────────────
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_ENDPOINT=https://api.minimax.io/anthropic/v1/messages
MINIMAX_MODEL=MiniMax-M2.5
OPENCLAW_MINIMAX_FALLBACK=1
OPENCLAW_MINIMAX_SESSION=xkb-summarizer
OPENCLAW_MINIMAX_AGENT=replace-with-your-agent-name

# ── 選填：路徑設定 ──────────────────────────────────
# WORKSPACE_DIR=./runtime-workspace
# BOOKMARKS_DIR=./runtime-workspace/memory/bookmarks

# ── 選填：Google Drive 同步 ─────────────────────────
RCLONE_REMOTE=your-drive-remote:XKnowledgeBase-Bookmarks

# ── 選填：個人化設定 ───────────────────────────────
XKB_USER_NAME=User

# ── 選填：Tiege queue / topic profile ──────────────
# XKB_QUEUE_PATH=./runtime-workspace/memory/x-knowledge-base/tiege-queue.json
# XKB_TOPIC_PROFILE_PATH=./runtime-workspace/memory/x-knowledge-base/topic_profile.json

# ── 可選：語意向量搜尋 ─────────────────────────────
# Keyword search does not require an embedding credential.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_API_KEY=replace-with-your-gemini-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# EMBEDDING_WORKSPACE_ROOT=./runtime-workspace
# XKB_CONFIG=./config/embedding.example.json

# ── 選填：YouTube 播放清單整合 ─────────────────────
# YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxx
